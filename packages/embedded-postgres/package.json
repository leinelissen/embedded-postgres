{
  "name": "embedded-postgres",
  "version": "15.19.0-beta.19",
  "description": "A package to run an embedded Postgresql database right from NodeJS",
  "exports": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/leinelissen/embedded-postgres"
  },
  "type": "module",
  "scripts": {
    "start": "tsc -w",
    "build": "tsc",
    "lint": "eslint ./src",
    "docs": "typedoc --plugin typedoc-plugin-markdown ./src/types.ts",
    "test": "vitest"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "database",
    "embedded"
  ],
  "author": "Lei Nelissen",
  "license": "MIT",
  "devDependencies": {
    "@embedded-postgres/symlink-reader": "^15.19.0-beta.19",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "^15.19.0-beta.19",
    "@embedded-postgres/darwin-x64": "^15.19.0-beta.19",
    "@embedded-postgres/linux-arm": "^15.19.0-beta.19",
    "@embedded-postgres/linux-arm64": "^15.19.0-beta.19",
    "@embedded-postgres/linux-ia32": "^15.19.0-beta.19",
    "@embedded-postgres/linux-ppc64": "^15.19.0-beta.19",
    "@embedded-postgres/linux-x64": "^15.19.0-beta.19",
    "@embedded-postgres/windows-x64": "^15.19.0-beta.19"
  },
  "dependencies": {
    "exit-hook": "^5.1.0",
    "pg": "^8.23.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "/dist/**/*",
    "README.md"
  ],
  "engines": {
    "node": ">=16"
  },
  "gitHead": "5b3e39624b6a9a1e3d53404684ee1239efa19020"
