{
    "compilerOptions": {
        "lib": ["es2022"],
        "target": "es2015",
        "incremental": true,
        "outDir": "./dist",
        "types": ["node"],
        "module": "Node16",
        "moduleResolution": "Node16",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "strict": true
    },
    "references": [
        {
            "path": "packages/embedded-postgres"
        }
    ],
    "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}